public class preInPost {

    static void fun(int n) {
        if (n == 0) return;

        System.out.print(n); // Pre
        fun(n - 1);

        System.out.print(n); // In
        fun(n - 1);

        System.out.print(n); // Post
    }

    public static void main(String[] args) {
        fun(3);
    }
}

